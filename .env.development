# Dev defaults to the real agentos-api on :8080. Origin only — the OpenAPI
# paths already carry the /api/v1 prefix, so the base must NOT include it.
# For the Prism mock (npm run mock), point .env.development.local at :4010.
VITE_API_BASE=http://localhost:8080
VITE_WS_BASE=ws://localhost:8080
VITE_REFRESH_ENABLED=false
